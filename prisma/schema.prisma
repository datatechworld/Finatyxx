  tenantId            String   @id @db.Uuid
  payrollCurrencyCode String   @db.Char(3)
  defaultPayDay       Int      @default(25)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  @@map("payroll_settings")
}

model NotificationSettings {
  tenantId        String   @id @db.Uuid
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  smsEnabled      Boolean  @default(false)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@map("notification_settings")
}

model AISettings {
  tenantId                     String   @id @db.Uuid
  enabled                      Boolean  @default(true)
  requireConfirmationForWrites Boolean  @default(true)
  allowFinancialPosting        Boolean  @default(false)
  modelName                    String?  @db.VarChar(120)
  updatedAt                    DateTime @updatedAt @db.Timestamptz(6)

  @@map("ai_settings")
}
