generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  CLOSED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum BranchAccessLevel {
  READ
  OPERATE
  MANAGE
}

enum ProductType {
  INVENTORY
  NON_INVENTORY
  SERVICE
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum PaymentStatus {
  DRAFT
  PENDING
  POSTED
  FAILED
  REVERSED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  BILLED
  CANCELLED
  CLOSED
}

enum StockDirection {
  IN
  OUT
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCK_COUNT
  WRITE_OFF
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AccountingFramework {
  IFRS_FOR_SMES
  FULL_IFRS
  LOCAL_GAAP
}

enum SystemAccountPurpose {
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  SALES_REVENUE
  SALES_RETURNS
  SALES_DISCOUNTS
  INVENTORY
  COST_OF_GOODS_SOLD
  INPUT_TAX
  OUTPUT_TAX
  TAX_PAYABLE
  CASH
  BANK
  PAYROLL_PAYABLE
  SALARY_EXPENSE
  RETAINED_EARNINGS
  FX_GAIN
  FX_LOSS
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
  VOID
}

enum FiscalPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum FinancialAccountType {
  CASH
  BANK
  MOBILE_MONEY
  PETTY_CASH
  PAYMENT_GATEWAY
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
  REVERSED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FeatureValueType {
  BOOLEAN
  INTEGER
  DECIMAL
  TEXT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionType {
  APPROVE
  REJECT
  COMMENT
  CANCEL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST
  VOID
  REVERSE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  EXPORT
  PERMISSION_CHANGE
  SUPPORT_ACCESS
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum AIExecutionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  POSTED
  PAID
  CANCELLED
}

enum TaxType {
  SALES
  PURCHASE
  WITHHOLDING
  PAYROLL
  OTHER
}

enum DocumentSequenceType {
  QUOTATION
  INVOICE
  CREDIT_NOTE
  RECEIPT
  PURCHASE_REQUEST
  PURCHASE_ORDER
  GOODS_RECEIPT
  SUPPLIER_BILL
  SUPPLIER_PAYMENT
  EXPENSE
  JOURNAL
  STOCK_TRANSFER
  STOCK_COUNT
  PAYROLL
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
  VOID
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum TransferLineStatus {
  PENDING
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  RECONCILED
  EXCLUDED
}

enum LoanStatus {
  DRAFT
  ACTIVE
  PAID_OFF
  DEFAULTED
  CANCELLED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum CustomFieldType {
  TEXT
  NUMBER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  SELECT
  MULTISELECT
  JSON
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  clerkId   String   @unique @db.VarChar(255)
  email     String?  @db.VarChar(320)
  firstName String?  @db.VarChar(120)
  lastName  String?  @db.VarChar(120)
  phone     String?  @db.VarChar(40)
  avatarUrl String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships     TenantMembership[]
  auditLogs       AuditLog[]
  roles           Role[]
  activities      ActivityLog[]
  aiConversations AIConversation[]

  @@index([email])
  @@map("users")
}

model Tenant {
  id                 String       @id @default(uuid()) @db.Uuid
  legalName          String       @db.VarChar(200)
  tradingName        String?      @db.VarChar(200)
  slug               String       @unique @db.VarChar(120)
  registrationNumber String?      @db.VarChar(100)
  taxIdentification  String?      @db.VarChar(100)
  industry           String?      @db.VarChar(120)
  countryCode        String       @db.Char(2)
  baseCurrencyCode   String       @db.Char(3)
  timezone           String       @default("Africa/Accra") @db.VarChar(80)
  email              String?      @db.VarChar(320)
  phone              String?      @db.VarChar(40)
  website            String?
  logoUrl            String?
  status             TenantStatus @default(TRIAL)
  trialEndsAt        DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  memberships           TenantMembership[]
  branches              Branch[]
  departments           Department[]
  customers             Customer[]
  suppliers             Supplier[]
  categories            ProductCategory[]
  units                 Unit[]
  products              Product[]
  warehouses            Warehouse[]
  quotations            Quotation[]
  invoices              Invoice[]
  payments              Payment[]
  stockMovements        StockMovement[]
  accounts              Account[]
  accountingSettings    AccountingSettings?
  accountingProfile     AccountingProfile?
  systemAccountMappings SystemAccountMapping[]
  journals              JournalEntry[]
  financialAccounts     FinancialAccount[]
  subscriptions         Subscription[]
  auditLogs             AuditLog[]
  roles                 Role[]

  @@unique([id, baseCurrencyCode])
  @@index([status])
  @@index([countryCode])
  @@map("tenants")
}

model TenantMembership {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  userId      String           @db.Uuid
  status      MembershipStatus @default(INVITED)
  joinedAt    DateTime?        @db.Timestamptz(6)
  invitedById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]
  branchAccess MembershipBranchAccess[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  name         String       @db.VarChar(160)
  code         String       @db.VarChar(40)
  email        String?      @db.VarChar(320)
  phone        String?      @db.VarChar(40)
  addressLine1 String?
  addressLine2 String?
  city         String?      @db.VarChar(120)
  region       String?      @db.VarChar(120)
  countryCode  String       @db.Char(2)
  isHeadOffice Boolean      @default(false)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departments       Department[]
  warehouses        Warehouse[]
  quotations        Quotation[]
  invoices          Invoice[]
  creditNotes       CreditNote[]
  payments          Payment[]
  financialAccounts FinancialAccount[]
  stockMovements    StockMovement[]
  membershipAccess  MembershipBranchAccess[]
  journalEntries    JournalEntry[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("branches")
}

model Department {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  branchId  String?      @db.Uuid
  name      String       @db.VarChar(160)
  code      String       @db.VarChar(40)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch    Branch?      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@map("departments")
}

model Role {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  name          String           @db.VarChar(120)
  code          String           @db.VarChar(80)
  description   String?
  isSystemRole  Boolean          @default(false)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions   RolePermission[]
  memberships   MembershipRole[]
  approvalSteps ApprovalStep[]
  user          User?            @relation(fields: [userId], references: [id])
  userId        String?          @db.Uuid

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  module      String           @db.VarChar(80)
  resource    String           @db.VarChar(80)
  action      String           @db.VarChar(60)
  description String?
  roles       RolePermission[]

  @@index([module, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  tenantId     String           @db.Uuid
  membershipId String           @db.Uuid
  roleId       String           @db.Uuid
  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role         Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("membership_roles")
}

model MembershipBranchAccess {
  tenantId     String            @db.Uuid
  membershipId String            @db.Uuid
  branchId     String            @db.Uuid
  accessLevel  BranchAccessLevel @default(READ)
  membership   TenantMembership  @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  branch       Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, membershipId, branchId])
  @@index([tenantId, branchId])
  @@map("membership_branch_access")
}

model Customer {
  id                        String                     @id @default(uuid()) @db.Uuid
  tenantId                  String                     @db.Uuid
  customerCode              String                     @db.VarChar(60)
  name                      String                     @db.VarChar(200)
  contactPerson             String?                    @db.VarChar(160)
  email                     String?                    @db.VarChar(320)
  phone                     String?                    @db.VarChar(40)
  taxNumber                 String?                    @db.VarChar(100)
  paymentTermsDays          Int                        @default(0)
  creditLimit               Decimal                    @default(0) @db.Decimal(20, 4)
  currencyCode              String                     @db.Char(3)
  billingAddress            Json?
  shippingAddress           Json?
  notes                     String?
  status                    RecordStatus               @default(ACTIVE)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(6)
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contacts                  CustomerContact[]
  quotations                Quotation[]
  invoices                  Invoice[]
  payments                  Payment[]
  ledgerEntries             CustomerLedgerEntry[]
  groups                    CustomerGroupMember[]
  deliveryNotes             DeliveryNote[]
  creditNotes               CreditNote[]
  recurringInvoiceTemplates RecurringInvoiceTemplate[]
  journalLines              JournalLine[]

  @@unique([tenantId, customerCode])
  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, status])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  customerId String   @db.Uuid
  name       String   @db.VarChar(160)
  jobTitle   String?  @db.VarChar(120)
  email      String?  @db.VarChar(320)
  phone      String?  @db.VarChar(40)
  isPrimary  Boolean  @default(false)
  customer   Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("customer_contacts")
}

model Supplier {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  supplierCode     String                @db.VarChar(60)
  name             String                @db.VarChar(200)
  contactPerson    String?               @db.VarChar(160)
  email            String?               @db.VarChar(320)
  phone            String?               @db.VarChar(40)
  taxNumber        String?               @db.VarChar(100)
  paymentTermsDays Int                   @default(0)
  currencyCode     String                @db.Char(3)
  billingAddress   Json?
  bankDetails      Json?
  notes            String?
  status           RecordStatus          @default(ACTIVE)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(6)
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrders   PurchaseOrder[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]
  purchaseRequests PurchaseRequest[]
  ledgerEntries    SupplierLedgerEntry[]
  journalLines     JournalLine[]

  @@unique([tenantId, supplierCode])
  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@map("suppliers")
}

model ProductCategory {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  parentId    String?      @db.Uuid
  name        String       @db.VarChar(160)
  code        String       @db.VarChar(60)
  description String?
  status      RecordStatus @default(ACTIVE)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@map("product_categories")
}

model Unit {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  name            String                  @db.VarChar(80)
  symbol          String                  @db.VarChar(20)
  precision       Int                     @default(2)
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products        Product[]
  conversionsFrom ProductUnitConversion[] @relation("ConversionFromUnit")
  conversionsTo   ProductUnitConversion[] @relation("ConversionToUnit")

  @@unique([tenantId, symbol])
  @@unique([tenantId, id])
  @@map("units")
}

model Product {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @db.Uuid
  sku                  String                  @db.VarChar(100)
  barcode              String?                 @db.VarChar(120)
  name                 String                  @db.VarChar(200)
  description          String?
  type                 ProductType
  categoryId           String?                 @db.Uuid
  baseUnitId           String?                 @db.Uuid
  defaultSalesPrice    Decimal                 @default(0) @db.Decimal(20, 4)
  defaultPurchasePrice Decimal                 @default(0) @db.Decimal(20, 4)
  trackInventory       Boolean                 @default(true)
  trackSerialNumbers   Boolean                 @default(false)
  reorderLevel         Decimal                 @default(0) @db.Decimal(20, 4)
  status               RecordStatus            @default(ACTIVE)
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(6)
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category             ProductCategory?        @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  baseUnit             Unit?                   @relation(fields: [tenantId, baseUnitId], references: [tenantId, id], onDelete: Restrict)
  quotationItems       QuotationItem[]
  invoiceItems         InvoiceItem[]
  stockMovements       StockMovement[]
  balances             InventoryBalance[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  supplierBillItems    SupplierBillItem[]
  unitConversions      ProductUnitConversion[]
  priceListItems       PriceListItem[]
  deliveryNoteItems    DeliveryNoteItem[]
  creditNoteItems      CreditNoteItem[]
  stockTransferItems   StockTransferItem[]
  stockCountItems      StockCountItem[]
  purchaseRequestItems PurchaseRequestItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, barcode])
  @@index([tenantId, name])
  @@map("products")
}

model Warehouse {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  branchId       String             @db.Uuid
  name           String             @db.VarChar(160)
  code           String             @db.VarChar(60)
  status         RecordStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  stockMovements StockMovement[]
  balances       InventoryBalance[]
  transfersOut   StockTransfer[]    @relation("TransferSourceWarehouse")
  transfersIn    StockTransfer[]    @relation("TransferDestinationWarehouse")
  stockCounts    StockCount[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  branchId        String          @db.Uuid
  customerId      String          @db.Uuid
  quotationNumber String          @db.VarChar(80)
  quotationDate   DateTime        @db.Date
  validUntil      DateTime?       @db.Date
  currencyCode    String          @db.Char(3)
  exchangeRate    Decimal         @default(1) @db.Decimal(20, 8)
  subtotal        Decimal         @db.Decimal(20, 4)
  discountTotal   Decimal         @default(0) @db.Decimal(20, 4)
  taxTotal        Decimal         @default(0) @db.Decimal(20, 4)
  total           Decimal         @db.Decimal(20, 4)
  status          QuotationStatus @default(DRAFT)
  notes           String?
  terms           String?
  acceptedAt      DateTime?       @db.Timestamptz(6)
  createdById     String          @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch          Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customer        Customer        @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items           QuotationItem[]
  invoices        Invoice[]

  @@unique([tenantId, quotationNumber])
  @@unique([tenantId, id])
  @@index([tenantId, customerId, status])
  @@index([tenantId, branchId, quotationDate])
  @@map("quotations")
}

model QuotationItem {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  quotationId    String    @db.Uuid
  productId      String?   @db.Uuid
  description    String
  quantity       Decimal   @db.Decimal(20, 4)
  unitPrice      Decimal   @db.Decimal(20, 4)
  discountAmount Decimal   @default(0) @db.Decimal(20, 4)
  taxRate        Decimal   @default(0) @db.Decimal(9, 6)
  taxAmount      Decimal   @default(0) @db.Decimal(20, 4)
  lineTotal      Decimal   @db.Decimal(20, 4)
  sortOrder      Int       @default(0)
  quotation      Quotation @relation(fields: [tenantId, quotationId], references: [tenantId, id], onDelete: Cascade)
  product        Product?  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, quotationId])
  @@map("quotation_items")
}

model Invoice {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  branchId           String              @db.Uuid
  customerId         String              @db.Uuid
  quotationId        String?             @db.Uuid
  invoiceNumber      String              @db.VarChar(80)
  invoiceDate        DateTime            @db.Date
  dueDate            DateTime            @db.Date
  currencyCode       String              @db.Char(3)
  exchangeRate       Decimal             @default(1) @db.Decimal(20, 8)
  subtotal           Decimal             @db.Decimal(20, 4)
  discountTotal      Decimal             @default(0) @db.Decimal(20, 4)
  taxTotal           Decimal             @default(0) @db.Decimal(20, 4)
  roundingAdjustment Decimal             @default(0) @db.Decimal(20, 4)
  total              Decimal             @db.Decimal(20, 4)
  amountPaid         Decimal             @default(0) @db.Decimal(20, 4)
  balanceDue         Decimal             @db.Decimal(20, 4)
  status             InvoiceStatus       @default(DRAFT)
  notes              String?
  terms              String?
  postedAt           DateTime?           @db.Timestamptz(6)
  sentAt             DateTime?           @db.Timestamptz(6)
  paidAt             DateTime?           @db.Timestamptz(6)
  voidedAt           DateTime?           @db.Timestamptz(6)
